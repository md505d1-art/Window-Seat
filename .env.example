# Supabase project (Settings → API). The anon key is safe to ship to the browser;
# row-level security in supabase/migrations protects each user's data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional overrides for the map. Defaults: OpenStreetMap tiles + Nominatim search.
# For production traffic use a commercial tile/geocoding provider (OSM's servers are for light use).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_GEOCODER_URL=
